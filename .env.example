# ===================================================
# Lost & Found Service - Environment Variables Template
# ===================================================

# Environment mode: development | production
NODE_ENV=development

# Backend API Port (Defaults to 5001 if 5000 is occupied on macOS)
PORT=5001

# Database Configuration
# Options: 'sqlite' (local zero-config) | 'postgres' (cloud managed PostgreSQL)
# If DATABASE_MODE is 'postgres' and DATABASE_URL is empty, system falls back to SQLite automatically.
DATABASE_MODE=sqlite
DATABASE_URL=

# SQLite Custom File Path (Optional, defaults to database/lost_and_found.sqlite)
DB_FILE_PATH=

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Frontend Environment Variable (used by client)
VITE_BACKEND_URL=http://localhost:5001

# JWT Secret for Session & Admin tokens
JWT_SECRET=super_secret_lost_found_jwt_token_key_change_in_production

# Optional Cloud Integrations (Optional, not required for local execution)
GEMINI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
